<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width= , initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <title>Write new chat</title>
  </head>
  <style>
    body {
      margin-left: 20px;
    }

    input {
      padding: 5px 15px;
      border-radius: 10px;
      border: 2px solid aqua;
    }

    textarea {
      padding: 5px 15px;
      border-radius: 10px;
      border: 2px solid aqua;
    }

    button {
      border-radius: 5px;
      border: 2px solid aqua;
    }
  </style>
  <body>
    <h3>Write New Chat..</h3>
    <form method="POST" action="/chats">
      <input placeholder="Who are you ?" name="from" />
      <br /><br />
      <textarea name="msg">Write your message here..</textarea>
      <br /><br />
      <input placeholder="Add receive" name="to" />
      <br /><br />
      <button>Create Chat</button>
    </form>
  </body>
</html>
